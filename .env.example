# Documentation only: process environment is read; this file is never auto-loaded.
MONGO_AUTH_MODE=oidc
MONGO_HOST=<cluster>.global.mongocluster.cosmos.azure.com
MONGO_DATABASE=vectorsearch_disposable_my_run
MONGO_COLLECTION_PREFIX=oidc
# Optional registered OIDC principal username:
# MONGO_OIDC_USERNAME=<principal>
# Native mode instead: set MONGO_AUTH_MODE=connection-string, unset MONGO_HOST and
# MONGO_OIDC_USERNAME, and inject MONGO_CONNECTION_STRING securely (never commit it).
DATA_FILE_WITH_VECTORS=data/Hotels_Vector.json
QUERY_VECTOR_FILE=data/query-vector.json
EMBEDDING_MODE=offline
VECTOR_SEARCH_ALLOW_WRITES=false
VECTOR_SEARCH_TIMEOUT_SECONDS=600
VECTOR_SEARCH_CASE_TIMEOUT_SECONDS=120
# Explicit real tests additionally require VECTOR_SEARCH_LIVE_TEST=1.
